# A-Share Alpha Studio Environment Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage Paths (relative to project root or absolute)
DATA_DIR=../data
DUCKDB_PATH=../data/market_analytics.duckdb
SQLITE_PATH=../data/studio_state.db
MODELS_DIR=../data/models

# Data Providers (AKShare primary, Baostock backup, Tushare optional)
DATA_PRIMARY_PROVIDER=akshare
DATA_BACKUP_PROVIDER=baostock
TUSHARE_TOKEN=

# Paper Trading & Scheduler
SCHEDULER_ENABLED=true
PAPER_INITIAL_CASH=1000000.0
INTRADAY_REFRESH_SECONDS=120

# Assisted Webhook Notifications (Optional)
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# Compliant Broker QMT / PTrade Config (Optional - requires authorized brokerage account)
QMT_USERDATA_PATH=
QMT_ACCOUNT_ID=
QMT_DRY_RUN=true
